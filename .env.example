# Copy to .env.local and fill in before running "npm run build".
# Public address of this website (used for sitemap and canonical links).
NEXT_PUBLIC_SITE_URL=https://your-domain.com
# Address of the admin panel for employees (for example https://admin.your-domain.com). Leave empty until ready.
NEXT_PUBLIC_ADMIN_URL=
# Google Play listing of the Android app. Leave empty until the app is published.
NEXT_PUBLIC_APP_URL=
